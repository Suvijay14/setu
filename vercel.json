{
  "build": {
    "env": {
      "NODE_OPTIONS": "--max-old-space-size=6144"
    }
  },
  "crons": [
    {
      "path": "/api/trigger-reminder",
      "schedule": "30 15 * * *"
    },
    {
      "path": "/api/summary-call",
      "schedule": "45 16 * * *"
    },
    {
      "path": "/api/training/analyze-b2c-logs",
      "schedule": "0 3 * * 1"
    }
  ]
}
